# === Local environment / IDE configs ===
.pandaos/
.opencode/
.claude/
.agents/
.mcp.json

# === Tool caches ===
web-app/.understand-anything/
.swarm/
.lh-harness/

# === Dependencies (recursive) ===
**/node_modules/

# === OS files ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor ===
.vscode/
.idea/
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# === RML cloned repos (not part of final project) ===
# compiler/ e running_examples/ restano fuori: sono sorgenti upstream, non
# nostre, e il compiler è già vendorizzato compilato in vendor/rml-compiler/.
RML_DOCS/RML_TESTS/compiler/
RML_DOCS/RML_TESTS/running_examples/

# monitor/ NON è escluso, anche se sta sotto RML_TESTS: è la libreria Prolog che
# il servizio esegue a ogni richiesta. Senza, Render clona un repo dove il
# Dockerfile fa COPY di una cartella inesistente e la build muore.
# È MIT (RML@DIBRIS) e la sua LICENSE è dentro la cartella.

# === RML generated (build-pl.ps1) ===
RML_DOCS/RML_TESTS/metrics/*.pl

# === Temp ===
*.log
*.tmp
*.bak

# === Lavoro temporaneo del servizio ===
# La cartella in cui server.py scrive spartiti e tracce, e le tracce delle sonde.
# Sono file di lavoro di una richiesta: tenerli fuori dal repo evita di
# committare spartiti e tracce che cambiano a ogni esecuzione.
alignment/scratch/
alignment/_probe_traces/
__pycache__/
*.pyc

# === Configurazione locale ===
# Il puntamento al servizio in locale (VITE_CADENZA_API) e' una scelta di chi
# sviluppa, non del progetto: committarlo farebbe girare gli altri sul servizio
# dell'autore. Il file .env.example resta tracciato e dice cosa metterci.
web-app/.env.local
web-app/.env.*.local

